# PulsePoll backend configuration
# Copy to `.env` (never commit it) or set these in your hosting provider's dashboard.
# The server automatically loads `.env` for local development; real env vars take precedence.

# ---- HTTP server ----
PORT=8080
# "release" in production (quieter logs, no debug routes), "debug" for local development
GIN_MODE=release

# ---- MongoDB ----
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongodb:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pulsepoll

# ---- Redis ----
# Option A: full URL (takes precedence over the fields below).
#   rediss:// (double "s") enables TLS automatically — use this for Upstash / Redis Cloud.
#   Example: rediss://default:<password>@<name>.upstash.io:6379
REDIS_URL=

# Option B: discrete fields.
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Set to true to force TLS with REDIS_ADDR (or with a plain redis:// REDIS_URL).
REDIS_TLS=false

# ---- Auth ----
# REQUIRED in production: long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=72

# ---- CORS ----
# The exact origin of your frontend, e.g. https://pulsepoll.example.com
# Same-origin deployments (Go serving the SPA) only need their own URL here.
CORS_ALLOW_ORIGIN=http://localhost:5173

# ---- Static frontend (optional) ----
# Override where the built SPA lives. Default search: ./frontend/dist, ../frontend/dist, ./dist
STATIC_DIR=
